# Server Configuration
# Note: default.conf:28 hardcodes proxy_pass http://localhost:3210
# Changing PORT alone will break /api/ — update nginx too.
PORT=3210

# Payment System Selection (server-side — required)
PAYMENT_SYSTEM=coinos

# Coinos Configuration (required when PAYMENT_SYSTEM=coinos)
COINOS_TOKEN=your_coinos_api_token
COINOS_USERNAME=your_coinos_username

# LNbits Configuration (only if PAYMENT_SYSTEM=lnbits)
LNBITS_URL=https://yourlnbitsurl
LNBITS_KEY=your_lnbits_key

# Client-Side Configuration (VITE_ prefix for Vite build-time injection)
VITE_API_BASE_URL=           # blank = same origin (nginx proxies /api/)
VITE_TIP_AMOUNTS=1000,5000,10000,20000

# DOM Element Overrides (defaults match index.html — uncomment to customize)
# VITE_QR_CONTAINER_ID=qr-code-container
# VITE_SHOW_TIP_BUTTON_ID=show-tip-options
# VITE_TIP_CONTAINER_ID=tip-amount-container
# VITE_WALLET_BUTTON_ID=open-wallet
