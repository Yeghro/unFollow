# --- Server-side (read by server.js) ---
PORT=3210
PAYMENT_SYSTEM=lnbits          # lnbits | getalby | coinos

# LNbits
LNBITS_URL=your_lnbits_url
LNBITS_KEY=your_lnbits_key

# GetAlby
ALBY_ACCOUNT_ID=yeghro

# Coinos
COINOS_TOKEN=your_coinos_api_token
COINOS_USERNAME=your_coinos_username

# --- Client-side (baked into the bundle by Vite at build time) ---
# Changing VITE_* values requires a rebuild of dist/
VITE_PAYMENT_SYSTEM=lnbits
VITE_API_BASE_URL=            # blank = same origin
VITE_TIP_AMOUNTS=1000,5000,10000,20000
VITE_ALBY_ACCOUNT_ID=yeghro
